    "eslint": "eslint --fix \"src/**/*.{js,jsx,ts,tsx,astro}\"",
    "stylelint": "stylelint --fix \"**/*.css\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "auto-theme-color-picker": "node ./scripts/auto-theme-color-picker.js",
    "searcher": "node ./scripts/searcher.js",
    "gen": "cmk"
  },
